---
interface Props {
  number: string;
  title: string;
  id?: string;
  level?: 'h2' | 'h1';
}
const { number, title, id, level = 'h2' } = Astro.props;
const Tag = level;
---

<div class="grid-12 items-baseline gap-y-3 border-t border-ink pt-4" id={id}>
  <span class="col-span-12 font-mono text-[0.8rem] text-accent md:col-span-2" aria-hidden="true">{number}</span>
  <Tag class="col-span-12 text-step-2 md:col-span-7">{title}</Tag>
  <div class="col-span-12 md:col-span-3 md:justify-self-end"><slot name="aside" /></div>
</div>
