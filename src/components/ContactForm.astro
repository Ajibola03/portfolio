---
// Netlify Forms: detected at deploy time from this static HTML. Works without JS.
const field = 'block w-full border border-rule bg-paper-raised px-4 py-3 text-ink focus:border-accent';
const label = 'mono-label mb-2 block';
---

<form
  name="contact"
  method="POST"
  action="/contact/thanks"
  data-netlify="true"
  netlify-honeypot="company"
  class="grid gap-6"
>
  <input type="hidden" name="form-name" value="contact" />
  <p class="hidden" aria-hidden="true">
    <label>Leave this empty: <input name="company" tabindex="-1" autocomplete="off" /></label>
  </p>
  <div>
    <label class={label} for="cf-name">Name</label>
    <input class={field} id="cf-name" name="name" type="text" autocomplete="name" required />
  </div>
  <div>
    <label class={label} for="cf-email">Email</label>
    <input class={field} id="cf-email" name="email" type="email" autocomplete="email" required />
  </div>
  <div>
    <label class={label} for="cf-message">Message</label>
    <textarea class={field} id="cf-message" name="message" rows="7" required></textarea>
  </div>
  <div>
    <button class="btn btn-primary cursor-pointer" type="submit">Send message</button>
  </div>
</form>
