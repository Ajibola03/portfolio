---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Message sent"
  description="Thanks for getting in touch with Ajibola Atoyebi. Your message arrived and you will get a reply by email. Meanwhile, browse the case studies and writing."
  path="/contact/thanks"
  ogImage="/og/index.png"
  noindex
>
  <div class="wrap pt-16 pb-8 md:pt-24">
    <p class="mono-label mb-6">Contact</p>
    <h1 class="text-step-4 leading-[1.02] tracking-[-0.02em]">Thanks. Your message is on its way.</h1>
    <p class="mt-6 max-w-[56ch] text-step-1 leading-snug">I'll reply by email. While you wait, the case studies are a good place to start.</p>
    <p class="mt-10"><a class="btn" href="/work">See the work</a></p>
  </div>
</BaseLayout>
